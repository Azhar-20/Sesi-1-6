import numpy as np
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import classification_report

# ==============================================================
# STUDI KASUS SESI 6: DEFORESTATION DRIVER ATTRIBUTION WITH AI
# Mengaitkan Sinyal Satelit dengan Pemicu Utama Kerusakan Hutan
# ==============================================================

# 1. SIMULASI FITUR SPEKTRAL SATELIT & DETEKSI PERUBAHAN
np.random.seed(42)
n_alerts = 350

data_satelit = {
    'alert_id': [f"ALT-{2026001 + i}" for i in range(n_alerts)],
    'ndvi_loss': np.random.uniform(0.20, 0.90, n_alerts),       # Tingkat hilangnya vegetasi hijau
    'nbr_loss': np.random.uniform(0.05, 0.80, n_alerts),        # Normalized Burn Ratio (bekas bakar)
    'jarak_ke_jalan_m': np.random.exponential(1200, n_alerts),  # Kedekatan akses jalan (meter)
    'luas_klaster_ha': np.random.lognormal(2.0, 0.8, n_alerts)  # Luas area bukaan tutupan kanopi
}

df_deforestasi = pd.DataFrame(data_satelit)

# 2. LOGIKA ATRIBUSI PENYEBAB LANGSUNG (GROUND-TRUTH DOMAIN EXPERT)
def tentukan_driver(row):
    if row['nbr_loss'] > 0.52:
        return 'Karhutla'
    elif row['luas_klaster_ha'] >= 20.0 and row['jarak_ke_jalan_m'] < 3000:
        return 'Perkebunan_Sawit'
    elif row['jarak_ke_jalan_m'] <= 250:
        return 'Infrastruktur_Jalan'
    else:
        return 'Perambahan_Kecil'

df_deforestasi['driver_utama'] = df_deforestasi.apply(tentukan_driver, axis=1)

# 3. PERSIAPAN DATA & MODEL TRAINING
fitur_spektral = ['ndvi_loss', 'nbr_loss', 'jarak_ke_jalan_m', 'luas_klaster_ha']
X = df_deforestasi[fitur_spektral]
y = df_deforestasi['driver_utama']

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.25, random_state=42, stratify=y
)

model_atribusi = RandomForestClassifier(n_estimators=100, random_state=42)
model_atribusi.fit(X_train, y_train)

# 4. EVALUASI MODEL ATRIBUSI AI
y_pred = model_atribusi.predict(X_test)

print("=" * 65)
print("SISTEM ATRIBUSI PENYEBAB DEFORESTASI (REMOTE SENSING & AI)")
print("=" * 65)
print(f"Total Alert Diproses  : {n_alerts} titik peringatan")
print(f"Proporsi Data Uji     : {len(X_test)} sampel peringatan satelit\n")

print("--- LAPORAN EVALUASI MODEL KLASIFIKASI DRIVER ---")
print(classification_report(y_test, y_pred))

# 5. CONTOH INFERENSI PADA PERINGATAN BARU DARI CITRA SATELIT
alert_baru = pd.DataFrame([
    {'ndvi_loss': 0.78, 'nbr_loss': 0.65, 'jarak_ke_jalan_m': 1400, 'luas_klaster_ha': 12.5}, # Karhutla
    {'ndvi_loss': 0.60, 'nbr_loss': 0.18, 'jarak_ke_jalan_m': 1500, 'luas_klaster_ha': 45.0}, # Perkebunan Sawit
    {'ndvi_loss': 0.45, 'nbr_loss': 0.10, 'jarak_ke_jalan_m': 80,   'luas_klaster_ha': 1.8}   # Koridor Jalan
])

hasil_prediksi = model_atribusi.predict(alert_baru)
probabilitas = model_atribusi.predict_proba(alert_baru)

print("--- INFERENSI ATRIBUSI PERINGATAN TERBARU ---")
for i, driver in enumerate(hasil_prediksi):
    keyakinan = np.max(probabilitas[i]) * 100
    print(f"Peringatan #{i+1} -> Terdeteksi: {driver:<19} (Keyakinan: {keyakinan:.1f}%)")
print("=" * 65)
